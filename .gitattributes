# Normalize line endings.
#
# Prettier writes LF, so LF is canonical in the repository and in the working
# tree. Without this, running `pnpm format` on Windows turns every touched file
# into a whole-file diff that is pure line-ending noise.
* text=auto eol=lf

# Binary assets are never converted.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.ttf binary
*.woff binary
*.woff2 binary
*.glb binary
*.fbx binary
*.zip binary
